# Supabase: Connect -> "Session pooler" URI
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PORT=5000

# Admin login for the admin portal (change these)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=any-long-random-string

# Google Drive upload (see README "Google Drive setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_NAME=traffic_uploads
